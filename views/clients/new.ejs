<link rel="stylesheet" href="/style.css">

<div class="form-card">
  <h2>Добавление клиента</h2>
  <form action="/clients" method="POST">
    <div class="form-group">
      <label for="name">Имя клиента</label>
      <input type="text" name="name" id="name" required placeholder="Введите имя и фамилию">
    </div>
    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" name="email" id="email" required placeholder="email@example.com">
    </div>
    <div class="form-group">
      <label for="phone">Телефон</label>
      <input type="tel" name="phone" id="phone" placeholder="+7 900 000-00-00">
    </div>
    <div class="form-group">
      <label for="course">Курс / направление</label>
      <input type="text" name="course" id="course" placeholder="Например: Веб-разработка">
    </div>
    <div class="form-group">
      <label for="status">Статус</label>
      <select name="status" id="status">
        <option value="active">Активен</option>
        <option value="completed">Завершил обучение</option>
        <option value="paused">Приостановил</option>
      </select>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Сохранить</button>
      <a href="/clients" class="btn btn-small">Отмена</a>
    </div>
  </form>
</div>