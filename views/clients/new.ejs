<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Добавление клиента · CRM Онлайн-школа</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <button class="mobile-menu-toggle" id="mobileMenuToggle">☰</button>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <div class="app">
    <aside class="sidebar">
      <div class="sidebar-brand">
        <a href="/">CRM Онлайн-школа</a>
      </div>
      <nav class="sidebar-nav">
        <% if (currentUser.roles.includes('curator')) { %>
          <a href="/clients" class="nav-item<%= (requestPath === '/clients') ? ' active' : '' %>">
            <span class="nav-icon">👥</span> Клиенты
          </a>
          <a href="/courses" class="nav-item<%= (requestPath.indexOf('/courses') === 0) ? ' active' : '' %>">
            <span class="nav-icon">📚</span> Курсы
          </a>
        <% } %>
        <% if (currentUser.roles.includes('admin')) { %>
          <a href="/accounts" class="nav-item<%= (requestPath === '/accounts') ? ' active' : '' %>">
            <span class="nav-icon">🔐</span> Аккаунты
          </a>
        <% } %>
      </nav>
      <div class="sidebar-footer">
        <span class="sidebar-user">Вход: <strong><%= currentUser.login %></strong></span>
        <form action="/logout" method="POST" class="sidebar-logout">
          <button type="submit" class="btn-logout">Выйти</button>
        </form>
      </div>
    </aside>
    <div class="app-content">
      <header class="top-bar">
        <div class="container top-bar-content">
          <h1 class="page-title">Добавление клиента</h1>

        </div>
      </header>
      <main class="container">
        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>
        <div class="form-card">
          <h2>Добавление клиента</h2>
          <form action="/clients" method="POST">
            <div class="form-group">
              <label for="name">Имя клиента</label>
              <input type="text" name="name" id="name" required placeholder="Введите имя и фамилию">
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" name="email" id="email" required placeholder="email@example.com">
            </div>
            <div class="form-group">
              <label for="phone">Телефон</label>
              <input type="tel" name="phone" id="phone" placeholder="+7 900 000-00-00">
            </div>
            <div class="form-group">
              <label for="course">Курс / направление</label>
              <input type="text" name="course" id="course" placeholder="Например: Веб-разработка">
            </div>
            <div class="form-group">
              <label for="status">Статус</label>
              <select name="status" id="status">
                <option value="active">Активен</option>
                <option value="completed">Завершил обучение</option>
                <option value="paused">Приостановил</option>
              </select>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Сохранить</button>
              <a href="/clients" class="btn btn-small">Отмена</a>
            </div>
          </form>
        </div>
      </main>
      <footer class="footer">
        <div class="container">&copy; 2026 CRM Онлайн-школа</div>
      </footer>
    </div>
  </div>
  <script>
    const toggle = document.getElementById('mobileMenuToggle');
    const sidebar = document.querySelector('.sidebar');
    const overlay = document.getElementById('sidebarOverlay');

    function openMenu() {
      sidebar.classList.add('open');
      overlay.classList.add('open');
    }

    function closeMenu() {
      sidebar.classList.remove('open');
      overlay.classList.remove('open');
    }

    toggle.addEventListener('click', openMenu);
    overlay.addEventListener('click', closeMenu);
  </script>
</body>
</html>