<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Вход в CRM Онлайн-школа</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="auth-wrapper">
    <main class="container">
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <div class="login-card">
        <h2>Вход в систему</h2>
        <form action="/login" method="POST">
          <div class="form-group">
            <label for="login">Логин</label>
            <input type="text" name="login" id="login" required placeholder="Введите логин" autofocus>
          </div>
          <div class="form-group">
            <label for="password">Пароль</label>
            <input type="password" name="password" id="password" required placeholder="Введите пароль">
          </div>
          <button type="submit" class="btn btn-primary btn-block">Войти</button>
        </form>
        <p class="hint">По умолчанию: логин <b>Admin</b>, пароль <b>Test</b></p>
      </div>
    </main>
  </div>
</body>
</html>