<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'CRM Онлайн-школа' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <button class="mobile-menu-toggle" id="mobileMenuToggle">☰</button>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <div class="app">
    <aside class="sidebar">
      <div class="sidebar-brand">
        <a href="/">CRM Онлайн-школа</a>
      </div>
      <nav class="sidebar-nav">
        <a href="/clients" class="nav-item<%= (requestPath === '/clients') ? ' active' : '' %>">
          <span class="nav-icon">👥</span> Клиенты
        </a>
        <a href="/accounts" class="nav-item<%= (requestPath === '/accounts') ? ' active' : '' %>">
          <span class="nav-icon">🔐</span> Аккаунты
        </a>
      </nav>
      <div class="sidebar-footer">
        <span class="sidebar-user">Вход: <strong><%= currentUser.login %></strong></span>
        <form action="/logout" method="POST" class="sidebar-logout">
          <button type="submit" class="btn-logout">Выйти</button>
        </form>
      </div>
    </aside>
    <div class="app-content">
      <header class="top-bar">
        <div class="container top-bar-content">
          <h1 class="page-title"><%= pageTitle || 'Аккаунты' %></h1>

        </div>
      </header>
      <main class="container">
        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>
        <div class="table-card">
          <div class="table-header">
            <h2>Управление аккаунтами</h2>
            <a href="/accounts/new" class="btn btn-primary">+ Создать аккаунт</a>
          </div>
          <table>
            <thead>
              <tr>
                <th>Логин</th>
                <th>Роль</th>
                <th>Создан</th>
                <th>Действия</th>
              </tr>
            </thead>
            <tbody>
              <% accounts.forEach(acc => { %>
                <tr>
                  <td><%= acc.login %></td>
                  <td><%= acc.role === 'admin' ? 'Администратор' : 'Пользователь' %></td>
                  <td><%= new Date(acc.createdAt).toLocaleString('ru-RU') %></td>
                  <td class="actions">
                    <a href="/accounts/<%= acc.id %>/edit" class="btn btn-small btn-edit">Редактировать</a>
                    <form action="/accounts/<%= acc.id %>/delete" method="POST" onsubmit="return confirm('Удалить аккаунт \"<%= acc.login %>\"?');">
                      <button type="submit" class="btn btn-small btn-delete">Удалить</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </main>
      <footer class="footer">
        <div class="container">&copy; 2026 CRM Онлайн-школа</div>
      </footer>
    </div>
  </div>
  <script>
    const toggle = document.getElementById('mobileMenuToggle');
    const sidebar = document.querySelector('.sidebar');
    const overlay = document.getElementById('sidebarOverlay');

    function openMenu() {
      sidebar.classList.add('open');
      overlay.classList.add('open');
    }

    function closeMenu() {
      sidebar.classList.remove('open');
      overlay.classList.remove('open');
    }

    toggle.addEventListener('click', openMenu);
    overlay.addEventListener('click', closeMenu);
  </script>
</body>
</html>